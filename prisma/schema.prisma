generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  role      Role       @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model Profile {
  id                  String         @id @default(cuid())
  name                String
  title               String[]
  summary             String
  email               String
  phone               String?
  location            String?
  linkedinUrl         String?
  githubUrl           String?
  twitterUrl          String?
  whatsappNumber      String?
  profileImageUrl     String?
  faviconUrl          String?
  logoUrl             String?
  cvUrl               String?
  cvFileName          String?
  mainTitle           String?
  heroDescription     String?
  professionalSummary String?
  websiteUrl          String?
  availabilityText    String?
  availabilityActive  Boolean        @default(true)
  primaryCtaText      String?
  primaryCtaUrl       String?
  secondaryCtaText    String?
  secondaryCtaUrl     String?
  heroImageUrl        String?
  titles              ProfileTitle[]
  isPublished         Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ProfileTitle {
  id        String   @id @default(cuid())
  profileId String
  title     String
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, order])
}

model AboutContent {
  id                  String       @id @default(cuid())
  sectionTitle        String       @default("About Me")
  subtitle            String?
  introduction        String?
  professionalSummary String?
  mission             String?
  ctaText             String?
  ctaUrl              String?
  isPublished         Boolean      @default(true)
  points              AboutPoint[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AboutPoint {
  id        String       @id @default(cuid())
  aboutId   String
  text      String
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  about     AboutContent @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([aboutId, order])
}

model Experience {
  id             String             @id @default(cuid())
  company        String
  role           String
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean            @default(false)
  description    String?
  achievements   String[]
  location       String?
  order          Int                @default(0)
  isPublished    Boolean            @default(true)
  employmentType String?
  technologies   String[]           @default([])
  systems        String[]           @default([])
  isFeatured     Boolean            @default(false)
  details        ExperienceDetail[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([order])
}

model ExperienceDetail {
  id           String               @id @default(cuid())
  experienceId String
  type         ExperienceDetailType
  text         String
  order        Int                  @default(0)
  experience   Experience           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([experienceId, type, order])
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  grade       String?
  description String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}

model Certification {
  id                 String    @id @default(cuid())
  name               String
  issuer             String
  issueDate          DateTime?
  expiryDate         DateTime?
  credentialId       String?
  credentialUrl      String?
  imageUrl           String?
  certificateFileUrl String?
  isFeatured         Boolean   @default(false)
  order              Int       @default(0)
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([order])
}

model Skill {
  id           String              @id @default(cuid())
  name         String
  category     SkillCategory
  proficiency  Int?
  iconUrl      String?
  evidence     String?
  skillGroupId String?
  skillGroup   SkillGroup?         @relation(fields: [skillGroupId], references: [id], onDelete: SetNull)
  projects     ProjectTechnology[]
  order        Int                 @default(0)
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([category])
  @@index([order])
}

model SkillGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  skills      Skill[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Tool {
  id          String       @id @default(cuid())
  name        String
  category    ToolCategory
  iconUrl     String?
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
}

model Project {
  id           String              @id @default(cuid())
  title        String
  description  String
  category     String?
  imageUrl     String?
  projectUrl   String?
  githubUrl    String?
  problem      String?
  solution     String?
  role         String?
  features     String[]            @default([])
  results      String[]            @default([])
  tags         String[]
  client       String?
  startDate    DateTime?
  endDate      DateTime?
  isFeatured   Boolean             @default(false)
  order        Int                 @default(0)
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  images       ProjectImage[]
  technologies ProjectTechnology[]

  @@index([order])
  @@index([isFeatured])
}

model ProjectImage {
  id         String   @id @default(cuid())
  projectId  String
  url        String
  altText    String?
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, order])
}

model ProjectTechnology {
  projectId String
  skillId   String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([projectId, order])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  logoUrl     String?
  websiteUrl  String?
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Achievement {
  id          String    @id @default(cuid())
  title       String
  description String
  value       String?
  prefix      String?
  suffix      String?
  label       String?
  date        DateTime?
  icon        String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  iconUrl     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  newTab    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ContactContent {
  id          String   @id @default(cuid())
  heading     String   @default("Let's Work Together")
  description String?
  email       String?
  phone       String?
  location    String?
  ctaText     String?
  ctaUrl      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoSettings {
  id                   String   @id @default(cuid())
  siteTitle            String
  metaDescription      String
  keywords             String[] @default([])
  openGraphTitle       String?
  openGraphDescription String?
  openGraphImage       String?
  faviconUrl           String?
  canonicalUrl         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MediaAsset {
  id        String    @id @default(cuid())
  name      String
  url       String
  kind      MediaKind
  mimeType  String?
  size      Int?
  altText   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind])
  @@index([createdAt])
}

model Testimonial {
  id             String   @id @default(cuid())
  authorName     String
  authorTitle    String?
  authorCompany  String?
  authorImageUrl String?
  content        String
  rating         Int      @default(5)
  isPublished    Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Resume {
  id        String   @id @default(cuid())
  version   String
  fileUrl   String
  fileName  String
  fileSize  Int?
  isActive  Boolean  @default(false)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum SkillCategory {
  CORE
  TECHNICAL
  SOFT
  LANGUAGE
}

enum ToolCategory {
  PROGRAMMING
  DATABASE
  CLOUD
  DEVOPS
  PRODUCTIVITY
  SYSTEMS
  SECURITY
  NETWORKING
  PROJECT_MANAGEMENT
  DESIGN
  COMMUNICATION
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum ExperienceDetailType {
  RESPONSIBILITY
  ACHIEVEMENT
}

enum MediaKind {
  IMAGE
  DOCUMENT
  ICON
  OTHER
}
